# Doxyfile configuration for generating documentation for the project
# Doxygen version: 1.9.1 or compatible

# Project information
PROJECT_NAME           = "Rock-Paper-Scissors"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Client-Server Game Documentation"
OUTPUT_DIRECTORY       = ./doc

# Source and input settings
INPUT                  = ./client ./server
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.cpp *.h *.ino
RECURSIVE              = YES

# Build settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

EXTENSION_MAPPING      = ino=C++

# Output formats
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# HTML settings
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE_HUE    = 200
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
FULL_PATH_NAMES        = NO
SHORT_NAMES            = YES